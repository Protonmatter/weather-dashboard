# Optional weather-cache origin. It must expose the Open-Meteo-compatible /v1/gfs path.
# Leave empty to call Open-Meteo directly.
VITE_MAP_FORECAST_BASE_URL=

# Raster tile provider. Keep attribution accurate when changing this template.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
VITE_MAP_TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
